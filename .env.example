# Racine du domaine public (canonical, Open Graph, JSON-LD).
# Le préfixe de sous-dossier est ajouté automatiquement via NEXT_PUBLIC_BASE_PATH.
NEXT_PUBLIC_SITE_URL=https://phib64.github.io

# Endpoint du formulaire de contact (service tiers type Formspree, Web3Forms...).
# Optionnel : une valeur par défaut est codée en dur dans components/contact-overlay.jsx.
# S'il est absent ou échoue, l'utilisateur voit un message d'erreur avec un lien mailto.
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxx

# Endpoint du chatbot (Worker Cloudflare qui relaie OpenRouter).
# Optionnel : sans cette variable, le bouton de chat n'est pas rendu.
# Aucune clé n'est requise côté site : celle d'OpenRouter est un secret du Worker
# (cf. worker/README.md).
# NEXT_PUBLIC_CHAT_ENDPOINT=https://portfolio-chat.<subdomain>.workers.dev

# Préfixe de déploiement GitHub Pages (géré par le CI, ne pas modifier).
# GITHUB_PAGES=true