# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/
/dist/

# Wrangler (état local des Workers)
/.wrangler/
content.json

# Production
/build

# Environnement local
# Next.js lit `.env.local` avant `.env`, et le fichier est propre au poste de
# travail. Il peut contenir un endpoint Formspree réel, qui n'est pas secret au
# sens strict (le préfixe `NEXT_PUBLIC_` le rend public de toute façon) mais
# n'a rien à faire dans l'historique Git. Le gabarit à copier est `.env.example`.
# `.env` (sans suffixe) n'est jamais commité non plus : seul `.env.example`
# est versionné.
.env
!.env.example
.env.local
.env*.local

# Documents personnels
# Le CV contient l'adresse du domicile, le téléphone et le parcours. `public/`
# est recopié tel quel dans `dist/` par `next build`, donc tout ce qu'y dort est
# téléchargeable à l'adresse du site — même sans lien dans l'interface.
# Seul `public/cv.pdf` est publié, et il l'est volontairement.
/public/CV2.pdf
