{
  // Config de test local, jetable : sert à faire pointer le Worker vers le digest
  // du build local (servi sur le port 8899) au lieu du site déployé. Sans elle,
  // `wrangler dev` irait chercher le contenu sur GitHub Pages.
  "name": "portfolio-chat",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000",
    "SITE_CONTENT_URL": "http://127.0.0.1:8899/content.json",
    "SITE_URL": "https://phib64.github.io/portfolio",
    "SITE_TITLE": "Portfolio Philippe Barbosa",
    "GITHUB_USER": "PhiB64"
  }
}
