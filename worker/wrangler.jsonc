{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-chat",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true
  },
  // Workers AI. Le binding est authentifié par le compte Cloudflare du Worker :
  // il n'y a donc aucun secret à gérer, et rien à exposer dans le bundle du
  // site. C'est ce qui a remplacé la clé `OPENROUTER_API_KEY`.
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    // Compteur partagé par localisation Cloudflare. C'est le seul rempart qui
    // tient : les compteurs en mémoire du Worker vivent dans l'isolate qui les a
    // créés, et les requêtes se répartissent sur des isolates différents — la
    // limite en mémoire n'a jamais été atteinte en test (20 requêtes en
    // parallèle, 20 réponses 200). Ce binding s'appuie sur un store mutualisé
    // au sein d'un même datacenter.
    //
    // `namespace_id` est un entier unique dans le compte. Deux Workers qui
    // partagent le même `namespace_id` partagent aussi leurs compteurs.
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "41702026",
      "simple": {
        // Fenêtre courte : elle absorbe les rafales de script, qui est le cas
        // d'usage réel (un robot qui boucle) plutôt que l'usage humain.
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    // Origines autorisées à appeler le Worker (séparateur : virgule). Ce sont des
    // valeurs publiques : elles peuvent rester dans le dépôt.
    //
    // `localhost:3000` permet de développer le site contre le Worker local
    // (`npm run dev` dans worker/ → http://127.0.0.1:8787).
    //
    // Workers AI n'a besoin d'aucune clé : l'authentification passe par le
    // binding `AI` ci-dessus. Il n'y a donc plus de secret dans ce projet.
    "ALLOWED_ORIGINS": "https://phib64.github.io,http://localhost:3000",

    // Adresse du digest de contenu publié par le site (`dist/content.json`,
    // généré par `scripts/build-chat-content.mjs` au build). Le Worker y lit les
    // projets, compétences et liens avant de répondre, avec un cache de dix
    // minutes.
    //
    // Elle est publique et versionnée avec le site : c'est la même information
    // que celle affichée sur la page, pas un secret. En développement local, viser
    // le build local (`npx serve dist`) pour tester un contenu non déployé.
    "SITE_CONTENT_URL": "https://phib64.github.io/portfolio/content.json"
  }
}
